rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function misPermisos() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.permisos;
    }

    function esAdmin() {
      return estaAutenticado() && 'admin' in misPermisos();
    }

    function tengoPermiso(clave) {
      return esAdmin() || (estaAutenticado() && clave in misPermisos());
    }

    // Cada quien puede leer su propio perfil (para saber sus permisos al
    // hacer login) y crearlo la primera vez que entra (auto-alta como
    // colaborador: solo alumnos.ver, o admin si su correo está en la lista
    // de administradores — ver AuthContext). Solo el admin puede cambiar
    // permisos o desactivar a alguien después de esa primera vez.
    match /usuarios/{uid} {
      allow read: if estaAutenticado() && (request.auth.uid == uid || esAdmin());
      allow create: if estaAutenticado() && request.auth.uid == uid;
      allow update, delete: if esAdmin();
    }

    // Alumnos: cualquiera con sesión puede leer (para el directorio de solo
    // lectura); solo quien tenga admin.importar (o admin) puede escribir.
    match /alumnos/{alumnoId} {
      allow read: if estaAutenticado();
      allow write: if tengoPermiso('admin.importar');
    }

    // Consumos de cafetería: solo quien tenga cafeteria.registrar puede
    // crear; cualquiera con sesión puede leer (lo usan caja y cafetería).
    match /consumos/{consumoId} {
      allow read: if estaAutenticado();
      allow create: if tengoPermiso('cafeteria.registrar') || tengoPermiso('cafeteria.carga_masiva') || tengoPermiso('caja.carga_masiva') || tengoPermiso('admin.carga_retroactiva');
      allow update: if esAdmin() || (tengoPermiso('caja.ver') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cargado','cargadoPor','fechaCargado','pagado','pagadoPor','fechaPagado']) && (!request.resource.data.pagado || request.resource.data.cargado));
      allow delete: if esAdmin();
    }

    // Estancias: captura normal, carga masiva o carga administrativa pueden crear/actualizar
    // (llegada y retiro); cualquiera con sesión puede leer (lo usa caja).
    match /estancias/{estanciaId} {
      allow read: if estaAutenticado();
      allow create: if tengoPermiso('estancia.registrar') || tengoPermiso('estancia.carga_masiva') || tengoPermiso('caja.carga_masiva') || tengoPermiso('admin.carga_retroactiva');
      allow update: if tengoPermiso('estancia.registrar') || tengoPermiso('estancia.carga_masiva') || tengoPermiso('caja.carga_masiva') || tengoPermiso('admin.carga_retroactiva') || (tengoPermiso('caja.ver') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cargado','cargadoPor','fechaCargado','pagado','pagadoPor','fechaPagado','metodoPago']))
        // El corte solo puede marcar la estancia como incluida en un corte.
        || (tengoPermiso('estancia.corte') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['corteId','corteEn']));
      allow delete: if esAdmin();
    }

    // Cortes de estancia (efectivo / Cometa entregados). Quien tenga el permiso
    // estancia.corte puede verlos y crearlos; no se editan, solo el admin borra.
    match /cortes_estancia/{corteId} {
      allow read: if tengoPermiso('estancia.corte');
      allow create: if tengoPermiso('estancia.corte');
      allow update: if false;
      allow delete: if esAdmin();
    }


    // Mensualidades/planes asignados a alumnos. Caja puede asignarlos con
    // el permiso específico; administración conserva control del catálogo.
    match /planes_comedor/{planId} {
      allow read: if estaAutenticado();
      allow create, update: if tengoPermiso('caja.asignar_plan_comedor') || tengoPermiso('admin.planes_comedor');
      allow delete: if esAdmin() || tengoPermiso('caja.asignar_plan_comedor');
    }

    // Catálogo de planes de comedor.
    // Separa los planes disponibles (catálogo) de las mensualidades
    // ya asignadas a alumnos (planes_comedor).
    match /catalogo_planes_comedor/{planId} {
      allow read: if estaAutenticado();
      allow create, update, delete: if tengoPermiso('admin.planes_comedor');
    }

    match /config/{docId} {
      allow read: if estaAutenticado();
      allow write: if (docId == 'notificaciones' && tengoPermiso('admin.notificaciones')) || tengoPermiso('admin.config_estancia') || tengoPermiso('admin.config_comedor') || (docId == 'calendario' && tengoPermiso('admin.calendario_comedor'));
    }

    // Registro semanal de cobro por alumno (casillas de "capturado" y
    // "pagado" en Caja). Cualquiera con acceso a Caja puede leer/escribir;
    // lo consulta también el panel de Pagos.
    match /cobros_semana/{id} {
      allow read: if estaAutenticado();
      allow write: if tengoPermiso('caja.ver');
    }
  }
}
