# Copia este archivo a ".env" (mismo folder) y llena los valores reales.
# ".env" NUNCA se sube a GitHub (ya está en .gitignore).

# --- Firebase (Consola de Firebase > Configuración del proyecto > tus apps) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Google Workspace: dominio institucional, ej. colegioibime.edu.mx ---
# Solo cuentas de correo de este dominio podrán iniciar sesión.
VITE_WORKSPACE_DOMAIN=

# Correo(s) que entran como Administrador automáticamente la primera vez
# que inician sesión (varios separados por coma, sin espacios extra).
VITE_ADMIN_EMAILS=tu-correo@tu-dominio.edu.mx

# --- Google Apps Script (ver appscript/Code.gs para desplegarlo) ---
# URL que te da Apps Script al "Implementar > Nueva implementación > Aplicación web".
VITE_APPSCRIPT_URL=
